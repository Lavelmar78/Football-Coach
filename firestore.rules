rules_version = '2';

// Shared Firebase project: Coach's Drill Library AND Assistant Manager.
//
// Both apps keep a document per team under /teams/{id}. They are told apart
// by shape:
//   Drill Library team   id = random UUID, fields: name, createdAt. Never updated.
//   Assistant Manager    id = WORD-XXXXXX code, fields: teamName, squads, season,
//                        history, ... Updated whenever a coach saves.
//
// Neither app can list teams: a document can only be read if its id is known.
//
//   teams/{teamId}                 drill team OR Assistant Manager team
//   teams/{teamId}/sessions/{id}   Drill Library practice sessions
//   teamAliases/{CODE}             Drill Library join code -> teamId
//   sharedSessions/{id}            Drill Library read-only share links

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Assistant Manager fields that may be written.
    function amFields() {
      return ['teamName','squads','squad_names','season','history',
              'liveMatch','createdAt','retired'];
    }

    match /teams/{teamId} {
      allow get: if signedIn();

      allow create: if signedIn() && (
        // Drill Library team (unchanged)
        (request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100)
        ||
        // Assistant Manager team
        (teamId.size() >= 6 && teamId.size() <= 20
          && request.resource.data.keys().hasOnly(amFields())
          && (!('teamName' in request.resource.data)
              || (request.resource.data.teamName is string
                  && request.resource.data.teamName.size() <= 60)))
      );

      // Only Assistant Manager teams (they have a squads field) can be updated,
      // and only its own fields. Drill Library teams stay immutable.
      allow update: if signedIn()
        && 'squads' in resource.data
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(amFields());

      allow delete: if false;

      // Knowing the teamId is what grants access to its sessions.
      match /sessions/{sessionId} {
        allow read, create, update, delete: if signedIn();
      }
    }

    match /teamAliases/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['teamId', 'teamName', 'createdAt'])
        && request.resource.data.teamId is string
        && exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId));
      allow update, delete: if false;
    }

    match /sharedSessions/{shareId} {
      // Shared links should open without the app having to sign in first.
      allow get: if true;
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
